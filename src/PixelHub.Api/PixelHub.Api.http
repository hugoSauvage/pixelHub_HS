# Carnet de tests PixelHub — cliquer sur « Send request » au-dessus de chaque bloc.
# Pour `dotnet run` : 5199 (launchSettings.json). L'API conteneurisée utilise 5200.
@host = http://localhost:5199

### Santé
GET {{host}}/

### Séance 1 — PostgreSQL
GET {{host}}/players
Accept: application/json

### Séance 1 — créer un joueur
POST {{host}}/players
Content-Type: application/json

{ "pseudo": "Pixel", "coins": 500 }

### Séance 2 — MongoDB : catalogue complet
GET {{host}}/games
Accept: application/json

### Séance 2 — filtrage par genre
GET {{host}}/games/genre/FPS
Accept: application/json

### Séance 2 — top 3
GET {{host}}/games/top/3
Accept: application/json

### Séance 2 — agrégation : note moyenne par genre
GET {{host}}/games/stats
Accept: application/json

### Séance 3 — cache du catalogue et mesure du temps
GET {{host}}/games/timed
Accept: application/json

### Séance 3 — ajouter des points au classement
POST {{host}}/leaderboard/Nova/points/4500

### Séance 3 — classement du meilleur au moins bien classé
GET {{host}}/leaderboard/top/5
Accept: application/json

### Séance 3 — rang d'un joueur (à partir de 1)
GET {{host}}/leaderboard/rank/Nova
Accept: application/json

### Séance 3 — signal de présence
POST {{host}}/online/Nova

### Séance 3 — nombre de joueurs en ligne
GET {{host}}/online/count
Accept: application/json

### Séance 4 — amis
GET {{host}}/social/Krayz/friends
Accept: application/json

### Séance 4 — recommandations (profondeur par défaut : 2)
GET {{host}}/social/Nova/recommendations
Accept: application/json

### Séance 4 — recommandations (profondeur : 3)
GET {{host}}/social/Nova/recommendations?depth=3
Accept: application/json

### Séance 4 — suggestions d'amis
GET {{host}}/social/Nova/friend-suggestions
Accept: application/json

### Séance 4 bis — boutique : Nova achète Terraria (1200 pièces)
POST {{host}}/shop/Nova/buy/Terraria

### Séance 4 bis — boutique : titre avec apostrophe et espaces encodés
POST {{host}}/shop/Nova/buy/Baldur%27s%20Gate%203

### Séance 4 bis — boutique : jeu gratuit (Valorant)
POST {{host}}/shop/Nova/buy/Valorant

### Séance 4 bis — boutique : jeu inconnu (404 attendu)
POST {{host}}/shop/Nova/buy/Tetris

### Séance 4 bis — boutique : racheter Valorant (conflit attendu)
POST {{host}}/shop/Nova/buy/Valorant

### Séance 4 bis — boutique : Luna achète Terraria
POST {{host}}/shop/Luna/buy/Terraria

### Séance 4 bis — meilleures ventes (Redis)
GET {{host}}/shop/bestsellers
Accept: application/json
    